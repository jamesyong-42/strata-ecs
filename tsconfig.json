{
  "compilerOptions": {
    /* Language / emit target */
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,

    /* Strictness — full strict suite (typed-array element access stays `number`;
       noUncheckedIndexedAccess is intentionally OFF to keep the hot path clean —
       the "never undefined" column invariants are enforced by runtime asserts + tests). */
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "allowUnreachableCode": false,

    /* Output (tsup drives the real build; this is for `tsc --noEmit` typecheck) */
    "declaration": true,
    "sourceMap": true,
    "outDir": "dist",
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src", "bench", "**/*.config.ts"],
  "exclude": ["dist", "node_modules"]
}
