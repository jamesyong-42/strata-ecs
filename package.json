{
  "name": "@vibecook/strata-ecs",
  "version": "0.5.0",
  "description": "An entity-component-system for TypeScript apps that edit documents — typed-array fast, reactive, with CRDT-backed multiplayer (Loro) as opt-in layers.",
  "type": "module",
  "license": "MIT",
  "author": "James Yong",
  "homepage": "https://github.com/jamesyong-42/strata-ecs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesyong-42/strata-ecs.git"
  },
  "bugs": {
    "url": "https://github.com/jamesyong-42/strata-ecs/issues"
  },
  "keywords": [
    "ecs",
    "entity-component-system",
    "typescript",
    "editor",
    "canvas",
    "crdt",
    "local-first",
    "reactivity"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/prod/index.js",
  "module": "./dist/prod/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./dist/dev/index.js",
      "default": "./dist/prod/index.js"
    },
    "./durable": {
      "types": "./dist/durable/index.d.ts",
      "development": "./dist/dev/durable/index.js",
      "default": "./dist/prod/durable/index.js"
    },
    "./ephemeral": {
      "types": "./dist/ephemeral/index.d.ts",
      "development": "./dist/dev/ephemeral/index.js",
      "default": "./dist/prod/ephemeral/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "development": "./dist/dev/tools/index.js",
      "default": "./dist/prod/tools/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "development": "./dist/dev/react/index.js",
      "default": "./dist/prod/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p src/tools --noEmit && tsc -p src/react --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:stress:smoke": "STRESS_SCALE=0.1 vitest run --config vitest.smoke.config.ts",
    "bench": "vitest bench --run",
    "smoke:consumer": "node scripts/consumer-smoke.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:stress:smoke",
    "example:canvas": "pnpm --filter @strata-ecs/example-canvas-editor dev",
    "example:desktop": "pnpm --filter @strata-ecs/example-canvas-desktop start",
    "collab:server": "pnpm --filter @strata-ecs/collab-server start",
    "prepublishOnly": "pnpm run ci && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "@fails-components/webtransport-transport-http3-quiche",
      "electron",
      "@vibecook/truffle"
    ]
  },
  "peerDependencies": {
    "loro-crdt": ">=1",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "loro-crdt": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.6",
    "loro-crdt": "^1.13.6",
    "prettier": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
