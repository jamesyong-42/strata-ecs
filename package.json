{
  "name": "strata-ecs",
  "version": "0.0.0",
  "description": "A collaborative ECS framework for editors and infinite-canvas apps, in TypeScript.",
  "type": "module",
  "license": "MIT",
  "author": "James Yong",
  "homepage": "https://github.com/jamesyong/strata-ecs#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jamesyong/strata-ecs.git"
  },
  "keywords": [
    "ecs",
    "entity-component-system",
    "typescript",
    "editor",
    "canvas",
    "crdt",
    "local-first",
    "reactivity"
  ],
  "packageManager": "pnpm@10.33.0",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable": {
      "types": "./dist/durable/index.d.ts",
      "import": "./dist/durable/index.js"
    },
    "./ephemeral": {
      "types": "./dist/ephemeral/index.d.ts",
      "import": "./dist/ephemeral/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit && tsc -p src/tools --noEmit && tsc -p src/react --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "bench": "vitest bench --run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ci": "pnpm typecheck && pnpm lint && pnpm test",
    "example:canvas": "pnpm --filter @strata-ecs/example-canvas-editor dev",
    "prepublishOnly": "pnpm run ci && pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.0.0",
    "fast-check": "^4.8.0",
    "happy-dom": "^20.10.6",
    "prettier": "^3.0.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
