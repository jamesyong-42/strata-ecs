{
  // strata-ecs/tools is a browser panel — same strictness as the root config plus DOM libs.
  // The ROOT tsconfig excludes src/tools precisely so the core keeps typechecking without
  // DOM (that absence is the "core never touches the browser" guarantee); this project is
  // the tools' half of `pnpm typecheck`.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "types": []
  },
  "include": ["./**/*.ts", "../core/**/*.ts"],
  // CRITICAL: the inherited root exclude contains "src/tools" — without resetting it here,
  // this project would typecheck ZERO tools files (adversarial-review catch).
  "exclude": []
}
